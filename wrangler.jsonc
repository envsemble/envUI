// The hosted site: a Worker that serves the static build in dist/site from `npm run build:site`,
// the Site at the root and the Docs under /docs, both from the one index.html. Page loads and
// files outside /assets/ are served without running the script; it answers /assets/ and requests
// that match no file. CONTRIBUTING.md's Hosting section describes deployment.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "envui",
  "main": "./apps/site/hosting/Worker.mjs",
  // From 2025-04-01, page loads of unknown paths get index.html without running the script.
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    // A path without a file answers with index.html, so the Site's routes and the Docs' under
    // /docs load from a deep link and on a refresh.
    "not_found_handling": "single-page-application",
    // The script answers /assets/ first, so a missing hashed file is not found even when a browser
    // opens it as a page, rather than index.html cached for a year under its name.
    "run_worker_first": ["/assets/*"],
  },
  // The workers.dev address and the Preview URLs of branches stay off until Cloudflare Access
  // protects them; the deploy steps in CONTRIBUTING.md turn them on after that.
  "workers_dev": false,
  "preview_urls": false,
  // `npm run site:dev -- --port <port>` chooses another port.
  "dev": { "ip": "127.0.0.1", "port": 8771 },
}
