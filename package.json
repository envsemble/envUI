{
  "name": "envui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/codemods",
    "packages/eslint-plugin",
    "packages/stylelint-config",
    "apps/catalogue"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @envsemble/envui-catalogue",
    "dev:library": "node scripts/WatchLibrary.mjs",
    "build": "npm run build:library && npm run build:catalogue",
    "build:library": "node scripts/BuildLibrary.mjs",
    "build:catalogue": "npm run build --workspace @envsemble/envui-catalogue && node scripts/FinalizeCatalogue.mjs",
    "build:site": "npm run build --workspace @envsemble/envui-catalogue -- --mode site && node scripts/FinalizeSite.mjs",
    "site:dev": "npm run build:site && wrangler dev",
    "site:serve": "wrangler dev",
    "typecheck": "node scripts/GenerateDocumentation.mjs && tsc -p packages/ui/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/ui.tsbuildinfo && tsc -p apps/catalogue/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/catalogue.tsbuildinfo",
    "check": "node scripts/Check.mjs",
    "check:affected": "node scripts/Check.mjs --affected",
    "test": "node --test tests/*.test.mjs packages/*/test/*.test.mjs bench/test/*.test.mjs",
    "test:browser": "playwright test --project=chromium --project=firefox --project=webkit --project=live-development",
    "test:contrast": "playwright test tests/browser/Contrast.spec.ts --project=chromium",
    "test:a11y": "npm run build:site && playwright test --project=a11y",
    "test:a11y:update": "npm run build:site && playwright test --project=a11y --update-snapshots=changed",
    "test:visual": "node scripts/VisualTests.mjs",
    "test:visual:update": "node scripts/VisualTests.mjs --update",
    "bench": "node bench/run.mjs",
    "lint": "eslint . --cache --cache-location .cache/eslint/",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\" \"apps/catalogue/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/Verify.mjs",
    "verify:no-visual": "node scripts/Verify.mjs --skip-visual",
    "brand:generate": "node scripts/GenerateBrandAssets.mjs",
    "icons:sync": "node scripts/SyncIcons.mjs",
    "icons:generate": "node scripts/GenerateIcons.mjs",
    "icons:check": "node scripts/GenerateIcons.mjs --check",
    "palette:generate": "node scripts/GeneratePalette.mjs",
    "tokens:build": "node scripts/BuildTokens.mjs",
    "tokens:check": "node scripts/GeneratePalette.mjs --check && node scripts/BuildTokens.mjs --check",
    "docs:props": "node scripts/ExtractProps.mjs",
    "docs:manifest": "node scripts/GenerateManifest.mjs",
    "docs:check": "node scripts/ExtractProps.mjs --check && node scripts/GenerateManifest.mjs --check",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@terrazzo/cli": "2.9.0",
    "@terrazzo/parser": "2.9.0",
    "@terrazzo/plugin-css": "2.9.0",
    "@terrazzo/token-tools": "2.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "culori": "4.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "ts-morph": "28.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "wrangler": "4.151.0",
    "yaml": "2.9.1"
  }
}
