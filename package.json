{
  "name": "envui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "apps/catalogue"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @envsemble/envui-catalogue",
    "dev:library": "node scripts/WatchLibrary.mjs",
    "build": "npm run build:library && npm run build:catalogue",
    "build:library": "node scripts/BuildLibrary.mjs",
    "build:catalogue": "npm run build --workspace @envsemble/envui-catalogue && node scripts/FinalizeCatalogue.mjs",
    "typecheck": "node scripts/BuildTokens.mjs && node scripts/GenerateDocumentation.mjs && tsc -p packages/ui/tsconfig.json --noEmit && tsc -p apps/catalogue/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --project=chromium --project=firefox --project=webkit --project=live-development",
    "test:contrast": "playwright test tests/browser/Contrast.spec.ts --project=chromium",
    "test:a11y": "node scripts/GenerateDocumentation.mjs && playwright test --project=a11y",
    "test:a11y:update": "node scripts/GenerateDocumentation.mjs && playwright test --project=a11y --update-snapshots=changed",
    "test:visual": "node scripts/VisualTests.mjs",
    "test:visual:update": "node scripts/VisualTests.mjs --update",
    "bench": "node bench/run.mjs",
    "lint": "eslint . --cache --cache-location .cache/eslint/",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\" \"apps/catalogue/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run icons:check && npm run tokens:check && npm run lint && npm run lint:css && npm run format:check && npm run typecheck && npm run build && npm test && npm run test:contrast && npm run test:browser -- --grep-invert @contrast && npm run test:a11y && node scripts/VisualTests.mjs --if-docker",
    "brand:generate": "node scripts/GenerateBrandAssets.mjs",
    "icons:sync": "node scripts/SyncIcons.mjs",
    "icons:generate": "node scripts/GenerateIcons.mjs",
    "icons:check": "node scripts/GenerateIcons.mjs --check",
    "tokens:build": "node scripts/BuildTokens.mjs",
    "tokens:check": "node scripts/BuildTokens.mjs --check",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@terrazzo/cli": "2.9.0",
    "@terrazzo/parser": "2.9.0",
    "@terrazzo/plugin-css": "2.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "culori": "4.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
