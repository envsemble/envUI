{
  "name": "envui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "apps/catalogue"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @envsemble/envui-catalogue",
    "dev:library": "node scripts/WatchLibrary.mjs",
    "build": "npm run build:library && npm run build:catalogue",
    "build:library": "node scripts/BuildLibrary.mjs",
    "build:catalogue": "npm run build --workspace @envsemble/envui-catalogue && node scripts/FinalizeCatalogue.mjs",
    "typecheck": "node scripts/GenerateDocumentation.mjs && tsc -p packages/ui/tsconfig.json --noEmit && tsc -p apps/catalogue/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "lint": "eslint . --cache --cache-location .cache/eslint/",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\" \"apps/catalogue/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run icons:check && npm run typecheck && npm run build && npm test && npm run test:browser",
    "brand:generate": "node scripts/GenerateBrandAssets.mjs",
    "icons:sync": "node scripts/SyncIcons.mjs",
    "icons:generate": "node scripts/GenerateIcons.mjs",
    "icons:check": "node scripts/GenerateIcons.mjs --check",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
