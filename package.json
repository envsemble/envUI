{
  "name": "envsemble-design-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "apps/docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @envsemble/docs",
    "dev:library": "node scripts/WatchLibrary.mjs",
    "build": "npm run build:library && npm run build:docs",
    "build:library": "node scripts/BuildLibrary.mjs",
    "build:docs": "npm run build --workspace @envsemble/docs && node scripts/FinalizeDocs.mjs",
    "typecheck": "tsc -p packages/ui/tsconfig.json --noEmit && tsc -p apps/docs/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run icons:check && npm run typecheck && npm run build && npm test && npm run test:browser",
    "icons:sync": "node scripts/SyncIcons.mjs",
    "icons:generate": "node scripts/GenerateIcons.mjs",
    "icons:check": "node scripts/GenerateIcons.mjs --check",
    "legacy:dev": "node scripts/Dev.mjs",
    "legacy:build": "node scripts/Build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
