{
  "name": "envui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/eslint-plugin",
    "packages/stylelint-config",
    "apps/site"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @envsemble/envui-site",
    "dev:library": "node scripts/build/WatchLibrary.ts",
    "build": "npm run build:library",
    "build:library": "node scripts/build/BuildLibrary.ts",
    "build:site": "npm run build --workspace @envsemble/envui-site && node scripts/site/FinalizeSite.ts",
    "site:dev": "npm run build:site && wrangler dev",
    "site:serve": "wrangler dev",
    "typecheck": "node scripts/docs/GenerateDocumentation.ts && tsc -p packages/ui/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/ui.tsbuildinfo && tsc -p apps/site/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/site.tsbuildinfo && tsc -p tests/types/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/types.tsbuildinfo && tsc -p tests/fixture/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/fixture.tsbuildinfo && tsc -p scripts/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tsc/scripts.tsbuildinfo",
    "check": "node scripts/test/Check.ts",
    "check:affected": "node scripts/test/Check.ts --affected",
    "test": "node --test tests/*/*.test.mjs packages/*/test/*.test.mjs",
    "test:browser": "playwright test --project=chromium --project=firefox --project=webkit --project=live-development",
    "test:contrast": "playwright test tests/browser/Contrast.spec.ts --project=chromium",
    "test:a11y": "npm run build:site && playwright test --project=a11y",
    "test:a11y:update": "npm run build:site && playwright test --project=a11y --update-snapshots=changed",
    "test:visual": "node scripts/test/VisualTests.ts",
    "test:visual:update": "node scripts/test/VisualTests.ts --update",
    "measure:size": "node scripts/test/MeasureSize.ts",
    "measure:runtime": "node scripts/test/MeasureRuntime.ts",
    "measure:site": "node scripts/test/MeasureSite.ts",
    "lint": "eslint . --cache --cache-location .cache/eslint/",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\" \"apps/site/src/**/*.css\"",
    "lint:unused": "knip --cache --cache-location .cache/knip --no-progress",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/test/Verify.ts",
    "verify:no-visual": "node scripts/test/Verify.ts --skip-visual",
    "brand:generate": "node scripts/build/GenerateBrandAssets.ts",
    "icons:sync": "node scripts/build/SyncIcons.ts",
    "icons:generate": "node scripts/build/GenerateIcons.ts",
    "icons:check": "node scripts/build/GenerateIcons.ts --check",
    "palette:generate": "node scripts/build/GeneratePalette.ts",
    "tokens:build": "node scripts/build/BuildTokens.ts && node scripts/build/SyncLintPackages.ts",
    "tokens:check": "node scripts/build/GeneratePalette.ts --check && node scripts/build/BuildTokens.ts --check && node scripts/build/SyncLintPackages.ts --check",
    "docs:props": "node scripts/docs/ExtractProps.ts",
    "docs:parts": "node scripts/docs/GenerateParts.ts",
    "docs:check": "node scripts/docs/ExtractProps.ts --check && node scripts/docs/GenerateParts.ts --check && node scripts/docs/GenerateDocumentation.ts --check && node scripts/docs/CheckSnippets.ts",
    "docs:snippets": "node scripts/docs/CheckSnippets.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "docs:dev-mode-image": "node scripts/docs/CaptureDevModeImage.ts",
    "docs:readme-images": "node scripts/docs/CaptureReadmeImages.ts",
    "site:part-sizes": "node scripts/site/RecordPartSizes.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@terrazzo/cli": "2.10.0",
    "@terrazzo/parser": "2.10.0",
    "@terrazzo/plugin-css": "2.10.0",
    "@terrazzo/token-tools": "2.10.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "culori": "4.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "knip": "6.43.0",
    "marked": "17.0.6",
    "minisearch": "7.2.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
