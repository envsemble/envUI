{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "customConditions": ["envui-source"],
    "paths": {
      "@docs-model/*": ["../scripts/docs/model/*"],
      "@envui-internal/*": ["../packages/ui/src/*"]
    }
  },
  // The configurations of the component tests, the fixture and the site, which run in Node.
  "files": ["component/vitest.config.ts", "fixture/vite.config.ts", "../apps/site/vite.config.ts"],
  "include": [
    "**/*.ts",
    "../playwright.config.ts",
    "../scripts/build/culori.d.ts",
    "../packages/ui/src/customProperties.d.ts"
  ],
  // The component tests and the fixture and type tests have tsconfigs of their own. The files
  // listed after them came over from untyped JavaScript and aren't typed yet: a list that only
  // shrinks, so give a file its types and take it off.
  "exclude": [
    "component",
    "fixture",
    "types",
    "contrast/ContrastRegistry.test.ts",
    "docs/CatalogueWording.test.ts",
    "docs/CheckSnippets.test.ts",
    "docs/DocumentationDiscovery.test.ts",
    "docs/DocumentationPages.test.ts",
    "docs/PackagedPages.test.ts",
    "docs/PageFigures.test.ts",
    "docs/PageFrontmatter.test.ts",
    "docs/PageSections.test.ts",
    "docs/Parts.test.ts",
    "docs/PatternPages.test.ts",
    "docs/Props.test.ts",
    "library/package/ClientDirectives.test.ts",
    "library/package/CodeHighlighting.test.ts",
    "library/package/PackageContents.test.ts",
    "library/package/PackageRendering.test.ts",
    "library/package/PackageResolution.test.ts",
    "library/package/Theme.test.ts",
    "library/package/ThemeBootstrap.test.ts",
    "library/package/rsc/ClientReferences.ts",
    "library/package/rsc/Render.ts",
    "library/package/rsc/ServerRender.ts",
    "library/rules/Composition.test.ts",
    "library/rules/HasSubjects.test.ts",
    "library/rules/NoShadows.test.ts",
    "library/rules/StyleImports.test.ts",
    "library/rules/composition/Analysis.ts",
    "library/source/AvatarGroup.test.ts",
    "library/source/CalendarHeatmap.test.ts",
    "library/source/Card.test.ts",
    "library/source/ChoiceFields.test.ts",
    "library/source/ColorPicker.test.ts",
    "library/source/DatePicker.test.ts",
    "library/source/Destinations.test.ts",
    "library/source/DevMode.test.ts",
    "library/source/DropZone.test.ts",
    "library/source/Field.test.ts",
    "library/source/Graphic.test.ts",
    "library/source/GraphicTrim.test.ts",
    "library/source/Layout.test.ts",
    "library/source/List.test.ts",
    "library/source/Markdown.test.ts",
    "library/source/Message.test.ts",
    "library/source/Meter.test.ts",
    "library/source/MotionTokens.test.ts",
    "library/source/NavigationDrawer.test.ts",
    "library/source/Pagination.test.ts",
    "library/source/Palette.test.ts",
    "library/source/Rating.test.ts",
    "library/source/RelativeTime.test.ts",
    "library/source/Table.test.ts",
    "library/source/TableOfContents.test.ts",
    "library/source/TextField.test.ts",
    "library/source/TimePicker.test.ts",
    "library/source/Tokens.test.ts",
    "library/source/WindowClasses.test.ts",
    "site/BrowserStandIns.test.ts",
    "site/BuildSearchIndex.test.ts",
    "site/Fit.test.ts",
    "site/PlaceCallouts.test.ts",
    "site/SearchResults.test.ts",
    "site/SitePrerender.test.ts",
    "site/SiteRoutes.test.ts",
    "tooling/ProductNames.test.ts",
    "tooling/Release.test.ts",
    "tooling/StylelintSuppressions.test.ts",
    "tooling/TestScope.test.ts"
  ]
}
