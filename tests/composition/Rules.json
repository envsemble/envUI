          "dev/ui/styles.ts",
          "dev/ui/surfaces.ts",
          "dev/ui/useLivePage.ts",
          "dev/units.ts",
          "dev/usedTokens.ts"
        ]
      },
      "Button": {
        "classes": ["env-icon-button"],
        "modules": ["actions/internal/ButtonBase.tsx"]
      },
      "AvatarButton": {
        "styles": ["Button.css"]
      },
      "ConfirmButton": {
        "styles": ["Button.css"]
      },
      "Link": {
        "styles": ["Button.css"]
      },
      "AnimatedNumber": {
