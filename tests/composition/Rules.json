      "color/internal/ColorFields.tsx": ["input"],
      "color/internal/ColorSlider.tsx": ["input"],
      "color/internal/SwatchList.tsx": ["role=\"listbox\"", "role=\"option\""],
      "dev/ui/Frame.tsx": ["role=\"slider\""],
      "feedback/Tooltip.tsx": [
        "role=\"button\"",
        "role=\"link\"",
        "role=\"tab\"",
        "role=\"menuitem\""
      ]
    },
    "dynamicRoles": {
      "$comment": "The roles a role attribute the source doesn't spell out can take, per module and per expression by its source text, such as role={role}: the check counts each, so an interactive one needs a leaf-control entry above. A role={…} whose module and expression aren't listed here is a finding of its own.",
