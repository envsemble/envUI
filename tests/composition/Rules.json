  "classes": {
    "$comment": "Every module is a component named after its file, owning the classes that start with env-<file name in kebab case> and the stylesheet of the same name. An entry below adds classes (prefixes), stylesheets and other modules to a component; slots are classes another module may emit inside the component when it imports one of the component's modules. A class belongs to the component with the longest matching prefix. A stylesheet listed for a component holds that component's own rules, never rules that restyle another component.",
    "shared": {
      "env-theme": "The theme boundary, which every popup and provider sets.",
      "env-window": "The theme boundary's container name, which dialogs, sheets and menus query when nothing nearer applies.",
      "env-text": "The text style helper.",
      "env-surface": "The surface helper, which components render through Surface.",
      "env-connected-rows": "The shared connected-row corners (ConnectedRows.css) of List and row radios.",
