      "index.css": "Imports every stylesheet.",
      "Base.css": "The layer order, the reset, the tokens, the theme boundary and the shared surface, icon and motion rules every component builds on.",
      "ConnectedRows.css": "Shared connected-row corners.",
      "Prose.css": "The prose typography Markdown and the rich-text components share.",
      "Motion.css": "The keyframes several components share.",
      "Skeleton.css": "The skeleton state every component that paints a container takes, by element and data-env-skeleton.",
      "Reset.css": "The box-sizing reset inside every theme boundary.",
      "HoverDetail.css": "The dotted underline of text that shows more, which HoverCard and Tooltip give a text trigger."
    },
    "childRules": {
      "$comment": "A container may lay out a child that belongs to another component: place, size and space it, never restyle it. Each rule lets one stylesheet's selectors name a child's classes, as long as they declare only layoutProperties and the rule's own properties.",
      "layoutProperties": [
        "display",
        "position",
        "inset",
        "inset-*",
        "top",
        "right",
        "bottom",
        "left",
        "margin",
        "margin-*",
        "padding",
        "padding-*",
        "inline-size",
        "block-size",
        "min-inline-size",
        "max-inline-size",
        "min-block-size",
        "max-block-size",
        "width",
        "height",
        "min-width",
        "max-width",
        "min-height",
        "max-height",
        "flex",
        "flex-*",
        "grid-*",
        "order",
        "align-self",
        "justify-self",
        "place-self"
      ],
      "rules": [
        {
          "stylesheet": "Page.css",
          "classes": [
            "env-page-header",
            "env-page-header-breadcrumbs",
            "env-page-header-description",
            "env-page-header-toolbar",
            "env-page-header-actions"
          ],
          "properties": ["--env-page-sticky-*", "scroll-margin-block-start"],
          "note": "A Page reckons the height of its sticky PageHeader from the rows the header has, read with :has(), so what scrolls into view in its content keeps clear of it; it never styles the header."
        },
        {
          "stylesheet": "ButtonGroup.css",
          "classes": ["env-button", "env-icon-button"],
          "properties": ["border-radius", "border-*-radius", "outline-offset", "gap"],
          "note": "ButtonGroup joins its buttons into one control: it sizes them, squares their inner corners and insets their focus rings; where it holds buttons of mixed variants, read with :has(), it spaces them apart with their own corners instead."
        },
        {
          "stylesheet": "TextField.css",
          "classes": ["env-icon-button"],
          "properties": ["content"],
          "note": "Under a coarse pointer a field's end actions keep their size, and an empty pseudo-element reaches their hit area to the touch height within the field."
        },
        {
          "stylesheet": "PickerPopup.css",
          "classes": ["env-button"],
          "properties": ["white-space", "overflow-wrap"],
          "note": "The actions in the picker card's footer under a date, month or time, such as Today, Now and Clear, keep their labels on one line, so a row too narrow for them wraps whole buttons rather than the words inside one."
        },
        {
          "stylesheet": "CommandPalette.css",
          "classes": ["env-list-row-end", "env-kbd", "env-kbd-combination"],
          "note": "Under a coarse pointer, where there is often no keyboard, the palette leaves out the shortcut keys at the end of its items."
        },
        {
          "stylesheet": "Code.css",
          "classes": ["env-spinner"],
          "note": "A code diff pads its loading state."
        },
        {
          "stylesheet": "Editor.css",
          "classes": ["env-toolbar", "env-toolbar-group"],
          "note": "An editor's formatting toolbar wraps its groups onto more rows, and offsets the row and its first group so the separator a wrapped row starts with lies outside its clip."
        },
        {
          "stylesheet": "Composer.css",
          "classes": ["env-icon-button"],
          "note": "A leading icon button lines its icon up with the composer's inset."
        },
        {
          "stylesheet": "AvatarGroup.css",
          "classes": ["env-avatar-fallback-initials"],
          "properties": ["--env-avatar-group-*"],
          "note": "A group reads with :has() whether its avatars show initials, which center in their circle, and then piles them looser and upright, setting only its own properties; it never styles the avatar."
        },
        {
          "stylesheet": "Combobox.css",
          "classes": ["env-avatar", "env-avatar-fallback-initials"],
          "properties": ["--env-avatar-size", "--env-combobox-start-*"],
          "note": "An avatar in a combobox's leading slot takes the slot's size; the combobox reads with :has() whether it shows initials, and where the slot is too small for them leaves it out or closes the slot, setting only its own properties and layout; it never styles the avatar."
        },
        {
          "stylesheet": "Markdown.css",
          "classes": ["env-checkbox"],
          "properties": ["vertical-align"],
          "note": "A task list item lines its checkbox up with the item's text."
        },
        {
          "stylesheet": "Scaffold.css",
          "classes": ["env-panel-dock"],
          "properties": ["container-type"],
          "note": "A Scaffold's body places a PanelDock directly in it across its scrollport, so the dock stays over the body's visible area while it scrolls; the body, its own element, becomes a size container only while it holds a dock."
        },
        {
          "stylesheet": "Scaffold.css",
          "classes": [
            "env-panes",
            "env-panes-main",
            "env-panes-list",
            "env-panes-detail",
            "env-panes-supporting",
            "env-panes-backdrop"
          ],
          "properties": ["z-index", "overflow"],
          "note": "Where the document scrolls, Panes in the body are as tall as their content, so a Scaffold fixes their supporting sheet and its backdrop to the window at the modal layers, as a Sheet is, and lets the panes grow with the page rather than scroll; it never restyles them."
        },
        {
          "stylesheet": "Sheet.css",
          "classes": ["env-dialog-content", "env-dialog-actions"],
          "properties": [],
          "note": "A resizable side sheet makes its content, which scrolls with the sheet, at least as tall as the sheet and the containing block of its resize handle, so the handle runs down the whole edge; a side sheet's content fills its height and its actions sit at its foot. It never restyles them."
        },
        {
          "stylesheet": "ColorSwatch.css",
          "classes": ["env-icon-button"],
          "properties": ["background", "border-radius"],
          "note": "An icon button in the default secondary variant that holds a swatch alone, read with :has(), is a rounded square with no fill at rest, so no round fill clashes with the square sample; it keeps Button's custom fill and its state fills on hover, focus and press."
        },
        {
          "stylesheet": "PickerPopup.css",
          "classes": ["env-calendar"],
          "properties": ["row-gap", "justify-items", "contain"],
          "note": "The picker card reads whether its body is a calendar alone, with :has(), to size itself, place the calendar and set the gap above its footer, and sizes a calendar alone to fill it: containing its inline size, so the card measures it at its seven days, and stretching it to the card's width; it never styles the calendar."
        }
      ]
    }
  }
}
