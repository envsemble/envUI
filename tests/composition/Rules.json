      },
      "Tooltip": {
        "modules": ["feedback/internal/TooltipPopup.tsx"],
        "slots": ["env-tooltip-disabled-target"]
      },
      "Toast": {
        "classes": ["env-toast"],
        "styles": ["Toast.css"],
        "modules": [
          "feedback/toast/ToastBody.tsx",
          "feedback/toast/ToastInternals.ts",
          "feedback/toast/ToastProvider.tsx",
          "feedback/toast/ToastRegion.tsx",
          "feedback/toast/ToastTypes.ts",
          "feedback/toast/useToast.ts",
          "feedback/toast/useToastController.ts"
        ]
