      "internal/ActionElement.tsx": ["a", "button"],
      "forms/TextField.tsx": ["input"],
      "forms/internal/TextareaControl.tsx": ["textarea"],
      "forms/Checkbox.tsx": ["input"],
      "forms/Radio.tsx": ["input"],
      "forms/Switch.tsx": ["input"],
      "actions/SegmentedControl.tsx": ["button"],
      "navigation/Tree.tsx": ["role=\"tree\""],
      "navigation/internal/TreeRow.tsx": ["role=\"treeitem\""],
      "forms/Calendar.tsx": ["role=\"grid\""],
      "forms/internal/MonthGrid.tsx": ["role=\"grid\""],
