{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "types": ["node", "vite/client", "@vitest/browser-playwright"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "customConditions": ["envui-source"]
  },
  "include": [
    "*.tsx",
    "Browser.ts",
    "Commands.ts",
    "Setup.ts",
    "../../packages/ui/src/customProperties.d.ts"
  ]
}
