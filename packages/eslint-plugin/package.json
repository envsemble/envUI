{
  "name": "@envsemble/eslint-plugin-envui",
  "version": "1.0.0-prerelease.5",
  "description": "ESLint rules that point people and coding agents to envUI components instead of hand-rolled controls and raw colors",
  "homepage": "https://github.com/envsemble/envUI/tree/main/packages/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/envsemble/envUI/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "design-system",
    "envsemble"
  ],
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/envUI.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "prepack": "node ../../scripts/build/SyncLintPackages.ts",
    "dogfood": "node scripts/Dogfood.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
