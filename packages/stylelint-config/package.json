{
  "name": "@envsemble/stylelint-config-envui",
  "version": "0.7.0",
  "description": "Stylelint config that keeps application styles on envUI's tokens and off envUI's private markup",
  "homepage": "https://github.com/envsemble/envUI/tree/main/packages/stylelint-config#readme",
  "bugs": {
    "url": "https://github.com/envsemble/envUI/issues"
  },
  "keywords": [
    "stylelint",
    "stylelint-config",
    "design-system",
    "envsemble"
  ],
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/envUI.git",
    "directory": "packages/stylelint-config"
  },
  "files": [
    "index.js",
    "tokens.js",
    "data",
    "plugins",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepack": "node scripts/SyncTokens.mjs",
    "sync:tokens": "node scripts/SyncTokens.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  },
  "devDependencies": {
    "stylelint": "17.16.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
