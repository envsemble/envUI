{
  "name": "@envsemble/envui",
  "version": "2.1.0",
  "description": "A React design system for B2B SaaS products and AI developer tools, documented for people and coding agents",
  "homepage": "https://github.com/envsemble/envUI#readme",
  "bugs": {
    "url": "https://github.com/envsemble/envUI/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "design-system",
    "component-library",
    "envsemble"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/envsemble/envUI.git",
    "directory": "packages/ui"
  },
  "bin": {
    "envui-graphic": "bin/envui-graphic.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "icon-manifest.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "envui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./code": {
      "envui-source": "./src/code.ts",
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js",
      "default": "./dist/code.js"
    },
    "./markdown": {
      "envui-source": "./src/markdown.ts",
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./diff": {
      "envui-source": "./src/diff.ts",
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.js",
      "default": "./dist/diff.js"
    },
    "./color": {
      "envui-source": "./src/color.ts",
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js",
      "default": "./dist/color.js"
    },
    "./theme-bootstrap": {
      "envui-source": "./src/theme-bootstrap.ts",
      "types": "./dist/theme-bootstrap.d.ts",
      "import": "./dist/theme-bootstrap.js",
      "default": "./dist/theme-bootstrap.js"
    },
    "./theme-storage": {
      "envui-source": "./src/theme-storage.ts",
      "types": "./dist/theme-storage.d.ts",
      "import": "./dist/theme-storage.js",
      "default": "./dist/theme-storage.js"
    },
    "./messages": {
      "envui-source": "./src/messages.ts",
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js",
      "default": "./dist/messages.js"
    },
    "./styles.css": {
      "envui-source": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./parts.json": "./docs/generated/parts.json",
    "./props.json": "./docs/generated/props.json",
    "./tokens.json": {
      "envui-source": "./src/generated/tokens.json",
      "default": "./dist/tokens.json"
    },
    "./icons/*": {
      "envui-source": "./src/icons/*.tsx",
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "imports": {
    "#styles/*": {
      "module": "./dist/styles/*",
      "node": "./dist/styles/empty.js",
      "default": "./dist/styles/*"
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@pierre/diffs": "1.5.2",
    "@react-aria/color": "3.2.1",
    "@react-aria/i18n": "3.13.1",
    "@react-stately/color": "3.10.1",
    "@shikijs/langs": "4.5.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0"
  }
}
