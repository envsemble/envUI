      "warning": {
        "emphasis": {
          "$description": "A solid warning fill; paired with fg.on-emphasis.",
          "$value": "{palette.amber.60}"
        },
        "muted": {
          "$description": "The translucent warning tint of badges and alerts.",
          "$value": {
            "colorSpace": "oklch",
            "components": { "$ref": "#/palette/amber/60/$value/components" },
            "alpha": 0.12
          }
        }
      },
      "danger": {
        "emphasis": {
          "$description": "A solid danger fill; paired with fg.on-emphasis.",
          "$value": "{palette.red.60}"
        },
        "muted": {
          "$description": "The translucent danger tint of badges and alerts.",
          "$value": {
            "colorSpace": "oklch",
            "components": { "$ref": "#/palette/red/60/$value/components" },
            "alpha": 0.12
