            "$description": "The success fill of toasts in both themes; paired with fg.on-strong.",
            "$value": "{palette.green.60}"
          },
          "hover": {
            "$description": "A control on the success toast under the pointer.",
            "$value": "{palette.green.50}"
          },
          "pressed": {
            "$description": "A control on the success toast while pressed.",
            "$value": "{palette.green.45}"
          }
        }
