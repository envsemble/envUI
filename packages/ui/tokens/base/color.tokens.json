      "default": {
        "$description": "Body text and the labels of rows, fields and choice controls.",
        "$value": "{palette.neutral.92}"
      },
      "muted": {
        "$root": {
          "$description": "Supporting text, icons, field labels, descriptions and placeholders, row details, unchecked checkbox rings: every former synonym (muted, quiet, icon, field label, hint, placeholder, row detail).",
          "$value": "{palette.neutral.60}"
        },
        "hover": {
          "$description": "Muted text that responds to the pointer, such as a Disclosure summary, gains contrast.",
          "$value": "{palette.neutral.65}"
        },
        "pressed": { "$description": "Muted text while pressed.", "$value": "{palette.neutral.70}" }
      },
      "control": {
        "$description": "The labels of navigation items, secondary buttons and Select options, the values of meters and sliders, and the thumb of a switch that is off.",
