{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "$description": "Semantic colors: {bg|fg|border}.{role}.{emphasis}[.{state}], aliasing the palette. Every fg.on-X pairs with its bg.X, and every hover and pressed state is its own token, so the contrast gate, the docs and the generated modules see the real values. This file holds the light scheme at standard contrast; color-scheme/dark.tokens.json and contrast/high.tokens.json override it. The flat names after the groups are the 0.7 custom properties, kept as aliases until components move to the semantic names.",
    "bg": {
      "page": {
        "$root": {
          "$description": "The page behind all content: the app frame, title bars and Surface background=\"page\".",
          "$value": "{palette.neutral.0}"
        },
        "hover": {
          "$description": "An interactive page-colored surface under the pointer.",
          "$value": "{palette.neutral.4}"
        },
        "pressed": {
          "$description": "An interactive page-colored surface while pressed.",
          "$value": "{palette.neutral.8}"
        }
      },
      "default": {
        "$root": {
          "$description": "The default surface: Surface, sidebars, standard menus.",
          "$value": "{palette.neutral.4}"
        },
        "hover": {
          "$description": "An interactive default surface, such as a card or a navigation item, under the pointer.",
          "$value": "{palette.neutral.10}"
        },
        "pressed": {
          "$description": "An interactive default surface while pressed.",
          "$value": "{palette.neutral.15}"
        }
      },
      "muted": {
        "$root": {
          "$description": "The muted surface: Surface background=\"muted\", radio rows. Lighter than the default surface in both themes.",
          "$value": "{palette.neutral.2}"
        },
        "hover": {
          "$description": "An interactive muted surface under the pointer.",
          "$value": "{palette.neutral.6}"
        },
        "pressed": {
          "$description": "An interactive muted surface while pressed.",
          "$value": "{palette.neutral.10}"
        }
      },
      "raised": {
        "$root": {
          "$description": "A raised surface: Surface background=\"raised\", dialogs, rows on a contrasting surface, outlined buttons.",
          "$value": "{palette.neutral.0}"
        },
        "hover": {
          "$description": "An interactive raised surface under the pointer.",
          "$value": "{palette.neutral.6}"
        },
        "pressed": {
          "$description": "An interactive raised surface while pressed.",
          "$value": "{palette.neutral.10}"
        }
      },
      "popup": {
        "$root": {
          "$description": "Popups over the page: menus, Select lists, popovers, the composer. They take elevation 2.",
          "$value": "{palette.neutral.0}"
        },
        "hover": {
          "$description": "A highlighted row in a popup.",
          "$value": "{palette.neutral.4}"
        },
        "pressed": { "$description": "A pressed row in a popup.", "$value": "{palette.neutral.8}" }
      },
      "field": { "$description": "Text fields and other inputs.", "$value": "{palette.neutral.0}" },
      "overlay": {
        "$description": "The scrim behind dialogs, drawn translucent by the component.",
        "$value": "{palette.neutral.92}"
      },
      "selected": {
        "$root": {
          "$description": "Selected navigation items, tabs, tree and table rows, and Select options; paired with fg.on-selected.",
          "$value": "{palette.blue.4}"
        },
        "hover": {
          "$description": "A selected item under the pointer.",
          "$value": "{palette.blue.10}"
        },
        "pressed": {
          "$description": "A selected item while pressed.",
          "$value": "{palette.blue.15}"
        }
      },
      "neutral": {
        "muted": {
          "$root": {
            "$description": "The translucent neutral fill of secondary buttons, tab rails, chips, switch tracks, meter tracks and skeletons: a layer of the text color, so it keeps its tone on every surface.",
            "$value": {
              "colorSpace": "oklch",
              "components": { "$ref": "#/palette/neutral/92/$value/components" },
              "alpha": 0.06
            }
          },
          "hover": {
            "$description": "The neutral fill under the pointer.",
            "$value": {
              "colorSpace": "oklch",
              "components": { "$ref": "#/palette/neutral/92/$value/components" },
              "alpha": 0.17
            }
          },
          "pressed": {
            "$description": "The neutral fill while pressed.",
            "$value": {
              "colorSpace": "oklch",
              "components": { "$ref": "#/palette/neutral/92/$value/components" },
              "alpha": 0.29
            }
          }
        },
        "subtle": {
          "$root": {
            "$description": "Controls without a fill at rest, such as quiet buttons, inactive tabs and menubar triggers.",
            "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0 }
          },
          "hover": {
            "$description": "The state layer over a control without a fill, under the pointer.",
            "$value": {
              "colorSpace": "oklch",
              "components": { "$ref": "#/palette/neutral/92/$value/components" },
              "alpha": 0.08
            }
          },
          "pressed": {
            "$description": "The state layer over a control without a fill, while pressed.",
            "$value": {
              "colorSpace": "oklch",
              "components": { "$ref": "#/palette/neutral/92/$value/components" },
              "alpha": 0.1
            }
          }
        },
        "emphasis": {
          "$description": "A solid neutral fill, such as a solid neutral badge; paired with fg.on-emphasis.",
          "$value": "{palette.neutral.60}"
        },
        "strong": {
          "$root": {
            "$description": "The dark neutral fill of tooltips and neutral toasts in both themes; paired with fg.on-strong.",
            "$value": "{palette.neutral.75}"
          },
          "hover": {
            "$description": "A control on the strong neutral fill under the pointer.",
            "$value": "{palette.neutral.60}"
          },
          "pressed": {
            "$description": "A control on the strong neutral fill while pressed.",
            "$value": "{palette.neutral.50}"
          }
        }
      },
      "brand": {
        "emphasis": {
          "$root": {
            "$description": "The brand fill of primary actions, chosen radios and the chosen calendar day; paired with fg.on-emphasis.",
            "$value": "{palette.blue.50}"
          },
          "hover": {
            "$description": "A primary action under the pointer.",
            "$value": "{palette.blue.60}"
          },
          "pressed": {
            "$description": "A primary action while pressed.",
            "$value": "{palette.blue.75}"
          }
        },
        "strong": {
          "$root": {
            "$description": "The saturated brand fill of checked checkboxes, switches that are on, sliders, meters and spinners; paired with fg.on-strong.",
            "$value": "{palette.blue.50}"
