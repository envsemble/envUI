        "$value": "{palette.blue.65}"
      },
      "success": { "$description": "Success text and icons.", "$value": "{palette.green.60}" },
      "warning": { "$description": "Warning text and icons.", "$value": "{palette.amber.60}" },
      "danger": {
        "$description": "Danger text and icons, and field errors.",
        "$value": "{palette.red.60}"
      },
      "done": { "$description": "Done text and icons.", "$value": "{palette.violet.60}" },
      "on-emphasis": {
