{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "member-identity": {
    "$type": "dimension",
    "avatar-size": { "$value": { "value": 2, "unit": "rem" } },
    "gap": { "$value": "{space.3}" },
    "copy-height": { "$value": { "value": 2.5, "unit": "rem" } },
    "name-size": { "$value": "{font.size.body}" },
    "name-line-height": { "$value": { "value": 1.25, "unit": "rem" } },
    "email-size": { "$value": "{font.size.body-small}" },
    "email-line-height": { "$value": { "value": 1.25, "unit": "rem" } }
  },
  "control": {
    "$type": "dimension",
    "height-small": { "$value": "{control.height}" },
    "height-compact": { "$value": { "value": 2, "unit": "rem" } },
    "height": { "$value": { "value": 2.5, "unit": "rem" } },
    "icon-size": { "$value": { "value": 1, "unit": "rem" } },
    "height-touch": { "$value": { "value": 2.75, "unit": "rem" } },
    "font-size": { "$value": "{font.size.body}" }
  },
  "icon-button": {
    "$type": "dimension",
    "size": { "$value": "{control.height-small}" }
  },
  "topbar": {
    "$type": "dimension",
    "height": { "$value": { "value": 3.25, "unit": "rem" } }
  },
  "title-bar": {
    "$type": "dimension",
    "height": {
      "$description": "A window title bar drawn by the application, which keeps compact controls.",
      "$value": { "value": 2.5, "unit": "rem" }
    }
  }
}
