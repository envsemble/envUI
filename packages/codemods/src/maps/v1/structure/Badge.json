{
  "@envsemble/envui": {
    "CounterBadge": {
      "report": "CounterBadge is Badge with count in 1.0: <Badge count={value}>, with variant=\"solid\" in the accent tone, which its accent count was. Change a tone that is an expression by hand.",
      "cases": [
        {
          "when": {
            "tone": ["accent"]
          },
          "element": "Badge",
          "props": {
            "value": {
              "to": "count"
            }
          },
          "add": {
            "variant": "solid"
          }
        },
        {
          "when": {
            "tone": ["neutral", null]
          },
          "element": "Badge",
          "props": {
            "value": {
              "to": "count"
            }
          }
        }
      ]
    },
    "Counter": {
      "report": "Counter is Badge with count in 1.0: <Badge count={value}>, with variant=\"solid\" in the accent tone, which its accent count was. Change a tone that is an expression by hand.",
      "cases": [
        {
          "when": {
            "tone": ["accent"]
          },
          "element": "Badge",
          "props": {
            "value": {
              "to": "count"
            }
          },
          "add": {
            "variant": "solid"
          }
        },
        {
          "when": {
            "tone": ["neutral", null]
          },
          "element": "Badge",
          "props": {
            "value": {
              "to": "count"
            }
          }
        }
      ]
    }
  }
}
