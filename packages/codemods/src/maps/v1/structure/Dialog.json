{
  "@envsemble/envui": {
    "Dialog": {
      "report": "Dialog's placement=\"right\" is a Drawer in 1.0: <Drawer side=\"end\">, with width md or lg for size standard or wide. Change a placement that is an expression by hand.",
      "cases": [
        {
          "when": {
            "placement": ["right"]
          },
          "element": "Drawer",
          "props": {
            "placement": null,
            "size": {
              "to": "width",
              "values": {
                "standard": null,
                "wide": "lg"
              }
            }
          },
          "add": {
            "side": "end"
          }
        }
      ]
    }
  }
}
