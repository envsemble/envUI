{
  "@envsemble/envui": {
    "Text": {
      "tone": {
        "to": "emphasis",
        "report": "Text's tone is emphasis in 1.0: primary is default, muted stays muted and quiet is subtle.",
        "values": {
          "primary": {
            "props": {
              "emphasis": "default"
            }
          },
          "quiet": {
            "props": {
              "emphasis": "subtle"
            }
          }
        }
      },
      "variant": {
        "current": ["display", "body", "headline", "title", "body-sm", "caption"],
        "report": "Text's variant is display, body, headline, title, body-sm or caption in 1.0: page-heading is headline, section-heading is title and supporting is body-sm.",
        "values": {
          "page-heading": {
            "props": {
              "variant": "headline"
            }
          },
          "section-heading": {
            "props": {
              "variant": "title"
            }
          },
          "supporting": {
            "props": {
              "variant": "body-sm"
            }
          }
        }
      }
    }
  }
}
