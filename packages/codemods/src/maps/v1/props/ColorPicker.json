{
  "@envsemble/envui": {
    "ColorPicker": {
      "hint": {
        "to": "description",
        "report": "ColorPicker's hint is description in 1.0."
      },
      "variant": {
        "current": ["outline", "floating", "underline", "ghost"],
        "report": "ColorPicker's variant is outline, floating, underline or ghost in 1.0: outlined is outline, plain is underline, quiet is ghost.",
        "values": {
          "outlined": {
            "props": {
              "variant": "outline"
            }
          },
          "plain": {
            "props": {
              "variant": "underline"
            }
          },
          "quiet": {
            "props": {
              "variant": "ghost"
            }
          }
        }
      }
    }
  }
}
