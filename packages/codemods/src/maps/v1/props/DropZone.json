{
  "@envsemble/envui": {
    "DropZone": {
      "compact": {
        "report": "DropZone's compact is size=\"sm\" in 1.0.",
        "values": {
          "true": {
            "props": {
              "size": "sm"
            }
          },
          "false": {}
        }
      },
      "onFiles": {
        "to": "onDropAccepted",
        "report": "DropZone's onFiles is onDropAccepted in 1.0."
      },
      "onReject": {
        "to": "onDropRejected",
        "report": "DropZone's onReject is onDropRejected in 1.0."
      }
    }
  }
}
