{
  "@envsemble/envui": {
    "DropZone": {
      "compact": {
        "report": "DropZone's compact is size=\"sm\" in 1.0.",
        "values": {
          "true": {
            "props": {
              "size": "sm"
            }
          },
          "false": {}
        }
      },
      "onFiles": {
        "to": "onFilesAccepted",
        "report": "DropZone's onFiles is onFilesAccepted in 1.0."
      },
      "onReject": {
        "to": "onFilesRejected",
        "report": "DropZone's onReject is onFilesRejected in 1.0."
      }
    }
  }
}
