        "values": {
          "small": {
            "props": {
              "size": "sm"
            }
          },
          "standard": {},
          "large": {
            "props": {
              "size": "lg"
            }
          },
          "display": {
            "props": {
              "size": "xl"
            }
          }
        }
      }
    },
    "AvatarButton": {
      "size": {
        "current": ["sm", "md", "lg"],
        "report": "AvatarButton's size is sm, md (the default) or lg in 1.0: small is sm, standard md and large lg.",
        "values": {
          "small": {
            "props": {
              "size": "sm"
            }
          },
          "standard": {},
          "large": {
            "props": {
              "size": "lg"
            }
          }
        }
      },
      "detail": {
        "to": "description",
        "report": "AvatarButton's detail is description in 1.0."
      }
    }
  }
}
