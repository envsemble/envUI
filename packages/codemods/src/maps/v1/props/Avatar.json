{
  "@envsemble/envui": {
    "Avatar": {
      "size": {
        "current": ["sm", "md", "lg", "xl"],
        "report": "Avatar's size is sm, md (the default), lg or xl in 1.0: small is sm, standard md, large lg and display xl.",
        "values": {
          "small": {
            "props": {
              "size": "sm"
            }
          },
          "standard": {},
          "large": {
            "props": {
              "size": "lg"
            }
          },
          "display": {
            "props": {
              "size": "xl"
            }
          }
        }
      },
      "label": {
        "to": "named",
        "report": "Avatar's label, which named the avatar as an image by its name, is named in 1.0."
      }
    },
    "AvatarGroup": {
      "size": {
