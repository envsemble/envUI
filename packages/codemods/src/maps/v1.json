  "removed": {
    "$comment": "Exports that became internal in 1.0, with what to use instead. A `value` is the constant's literal, which a codemod can inline.",
    "@envsemble/envui": {
      "LoadingBar": {
        "use": "AppShell's loading and loadingLabel props show page progress along the bottom of its topbar; Progress shows the progress of a task."
      },
      "LoadingBarProps": {
        "use": "AppShell's loading and loadingLabel props show page progress along the bottom of its topbar; Progress shows the progress of a task."
      },
      "Toast": {
        "use": "Show notifications through useToast() inside Toast.Provider. The manual Toast is internal; the `Toast` export is now the namespace of Toast.Provider."
      },
      "ToastProps": {
        "use": "Describe a notification with ToastNotification, the argument of useToast().show()."
      },
      "getInitials": {
        "use": "Avatar shows the initials itself with fallback=\"initials\"; derive initials in the application for custom layouts."
      },
      "useLinkComponent": {
        "use": "Render envUI's Link, Button with href, NavList.Item or Menu.Item with href, which use the LinkProvider's component; or read the router's link component in the application."
      },
      "useSidebarCompact": {
        "use": "Keep the sidebar's collapsed state in the application through AppShell's collapsed and onCollapsedChange props."
      }
    },
    "@envsemble/envui/theme-bootstrap": {
      "defaultThemeStorageKey": {
        "use": "The default storage key is the string \"env-theme\"; pass the same storageKey to createThemeBootstrapScript and ThemePreferenceProvider to change it.",
        "value": "env-theme"
      }
    }
  },
  "props": {
    "$comment": "Props of 0.x components that 1.0 removed or changed, per entry point and component, by its 1.0 name. Each literal value of a prop maps to the props that replace it, in its place: an empty object drops the prop, and a replacement prop the element already sets is kept as it is. `report` says what replaces the prop; the v1-props codemod reports it at each use whose value is not listed, such as an expression, and with a value's own `report` at each use of that value.",
    "@envsemble/envui": {
      "TextField": {
        "compact": {
          "report": "TextField's compact is gone: fields take the control height by default, and size=\"sm\" gives the small one. For a compact app or region, set scale=\"compact\" on its Theme.",
          "values": {
            "true": {
              "props": {
                "showLabel": false
              },
              "report": "compact is gone: the field takes the control height, and showLabel={false} keeps its label hidden as compact did. For a compact app or region, set scale=\"compact\" on its Theme."
            },
            "false": {
              "props": {
                "variant": "floating"
              },
              "report": "compact={false} was the tall floating field, which is variant=\"floating\" now."
            }
          }
        }
      },
      "SearchField": {
        "compact": {
          "report": "SearchField's compact is gone: it takes the control height, and showLabel shows its label. For a compact app or region, set scale=\"compact\" on its Theme.",
          "values": {
            "true": {},
            "false": {
              "props": {
                "showLabel": true,
                "variant": "floating"
              },
              "report": "compact={false} was the tall floating field, which is variant=\"floating\" now."
            }
          }
        }
      },
      "Select": {
        "density": {
          "report": "Select's density is gone: size=\"sm\" gives the small trigger, and every popup has the menus' anatomy. For a compact app or region, set scale=\"compact\" on its Theme.",
          "values": {
            "compact": {
              "props": {
                "size": "sm"
              }
            },
            "standard": {
              "report": "the popup now has the menus' anatomy, with a check mark on the chosen option."
            }
          }
        }
      },
      "Combobox": {
        "density": {
          "report": "Combobox's density is gone: fields take the control height by default, size=\"sm\" gives the small one and variant=\"floating\" the tall one. For a compact app or region, set scale=\"compact\" on its Theme.",
          "values": {
            "compact": {
              "props": {
                "size": "sm",
                "showLabel": false
              }
            },
            "standard": {
              "props": {
                "variant": "floating"
