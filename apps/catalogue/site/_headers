# Response headers of the hosted catalogue. scripts/FinalizeSite.mjs copies this file into
# dist/site, and the Worker in wrangler.jsonc applies it. A response collects the headers of every
# rule matching its path, in order; "! Name" removes a header an earlier rule set.

# Every page, including the archived versions and routes answered with index.html. Pages are
# checked for changes on each load, and only the reader's browser keeps a copy.
/*
  Cache-Control: private, no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Vite names these files by a hash of their content, so a file never changes under its name.
/assets/*
  ! Cache-Control
  Cache-Control: private, max-age=31536000, immutable
