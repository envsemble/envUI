{
  "$comment": "Raw JSX elements that envUI already covers. weight is the cost of one occurrence in the raw-HTML part of the score; use names the envUI exports to suggest instead. input types override the input entry; null means the element is not counted.",
  "elements": {
    "button": { "weight": 1, "use": ["Button", "IconButton"] },
    "input": { "weight": 1, "use": ["TextField", "SearchField"] },
    "select": { "weight": 1, "use": ["Select", "Combobox"] },
    "textarea": { "weight": 1, "use": ["Textarea"] },
    "dialog": { "weight": 1, "use": ["Dialog"] },
    "table": { "weight": 1, "use": ["Table"] },
    "progress": { "weight": 1, "use": ["Progress"] },
    "meter": { "weight": 1, "use": ["Meter"] },
    "details": { "weight": 1, "use": ["Disclosure"] },
    "kbd": { "weight": 0.5, "use": ["Kbd"] },
    "nav": { "weight": 0.5, "use": ["AppShell", "NavList", "Breadcrumbs"] },
    "aside": { "weight": 0.5, "use": ["AppShell", "Dialog"] },
    "svg": { "weight": 0.5, "use": ["@envsemble/envui/icons/*", "Icon"] }
  },
  "inputTypes": {
    "hidden": null,
    "checkbox": ["Checkbox", "Switch"],
    "radio": ["RadioGroup", "Radio"],
    "range": ["Slider"],
    "file": ["DropZone"],
    "date": ["DatePicker"],
    "datetime-local": ["DatePicker"],
    "time": ["DatePicker"],
    "search": ["SearchField"],
    "color": ["ColorPicker"]
  },
  "roles": {
    "button": ["Button", "IconButton"],
    "link": ["Link"],
    "switch": ["Switch"],
    "checkbox": ["Checkbox"],
    "radio": ["Radio"],
    "radiogroup": ["RadioGroup"],
    "tab": ["Tabs"],
    "tablist": ["Tabs"],
    "tabpanel": ["Tabs"],
    "dialog": ["Dialog"],
    "alertdialog": ["Dialog"],
    "menu": ["Menu"],
    "menubar": ["Menubar"],
    "menuitem": ["Menu"],
    "menuitemcheckbox": ["Menu"],
    "menuitemradio": ["Menu"],
    "listbox": ["Select", "Combobox", "CommandPalette"],
    "option": ["Select", "Combobox", "CommandPalette"],
    "combobox": ["Combobox", "CommandPalette"],
    "searchbox": ["SearchField"],
    "slider": ["Slider"],
    "progressbar": ["Progress"],
    "meter": ["Meter"],
    "alert": ["Alert"],
    "status": ["Alert", "Toast"],
    "tooltip": ["Tooltip"],
    "navigation": ["AppShell", "Breadcrumbs"],
    "table": ["Table"],
    "grid": ["Table"],
    "tree": ["Tree"]
  },
  "anchorAsButton": { "weight": 1, "use": ["Button", "Link"] },
  "anchorLink": { "weight": 0.5, "use": ["Link", "NavList", "Button href"] },
  "clickableElement": { "weight": 1, "use": ["Button", "IconButton", "ClickableCard"] }
}
